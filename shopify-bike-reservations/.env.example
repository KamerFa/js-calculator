# Shopify App Credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SCOPES=read_products,write_products,read_orders,write_orders,read_draft_orders,write_draft_orders

# App URL (your Render service URL)
SHOPIFY_APP_URL=https://your-app-name.onrender.com
HOST=https://your-app-name.onrender.com

# Database (Render PostgreSQL — use the Internal Database URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# WhatsApp Notifications (via WhatsApp Business API or Twilio)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER=+38761XXXXXXX

# Notification recipient (your phone/email)
OWNER_EMAIL=owner@yourbusiness.com
OWNER_WHATSAPP=+38761XXXXXXX

# Default currency
DEFAULT_CURRENCY=BAM
