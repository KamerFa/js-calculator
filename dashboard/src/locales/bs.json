  "wisdom": {
    "label": "Riječi mudrosti",
    "prev": "Preth",
    "next": "Sljedeća",
    "quote_0": "Jednog dana će naša patnja postati snaga onih koji ne zaboravljaju.",
    "author_0": "Alija Izetbegović",
    "quote_1": "Ja sam za istinu, bez obzira ko je govori. Ja sam za pravdu, bez obzira za koga ili protiv koga je.",
    "author_1": "Malcolm X",
    "quote_2": "Čovjek koji na svijet gleda sa 50 godina isto kao sa 20 je uzalud potrošio 30 godina svog života.",
    "author_2": "Muhammed Ali",
    "quote_3": "Ne dopusti da te teškoće ispune tjeskobom; na kraju krajeva, samo u najtamnijim noćima zvijezde sjaje najjače.",
    "author_3": "Imam Ali ibn Ebi Talib",
    "quote_4": "Najjači među vama je onaj koji kontroliše svoju srdžbu.",
    "author_4": "Poslanik Muhammed (a.s.)",
    "quote_5": "Ako se pravda čini drugima, čak i na štetu vaših interesa, donijet će vam vječnu slavu.",
    "author_5": "Omer ibn el-Hattab",
    "quote_6": "Podižite svoje riječi, ne svoj glas. Kiša je ta koja uzgaja cvijeće, a ne grmljavina.",
    "author_6": "Rumi",
    "quote_7": "Ljudi koji su zaista jaki podižu druge. Ljudi koji su zaista moćni okupljaju druge.",
    "author_7": "Malcolm X",
    "quote_8": "Narodi nisu poraženi invazijom; poraženi su gubitkom svog unutarnjeg bića.",
    "author_8": "Muhammed Ikbal",
    "quote_9": "Kada vidite ugnjetavanje, više niste posmatrač — vi ste sudionik.",
    "author_9": "Alija Izetbegović",
    "quote_10": "Pomozi svom bratu, bio on nasilnik ili ugnjetavan. Ako je nasilnik, spriječi ga od nasilja; to je tvoja pomoć njemu.",
    "author_10": "Poslanik Muhammed (a.s.)",
    "quote_11": "Šutnja pred nepravdom je tihi pristanak na nepravdu.",
    "author_11": "Imam Ali ibn Ebi Talib",
    "quote_12": "Rana je mjesto gdje Svjetlost ulazi u tebe.",
    "author_12": "Rumi",
    "quote_13": "Narod bez znanja o svojoj prošlosti, porijeklu i kulturi je kao drvo bez korijena.",
    "author_13": "Malcolm X",
    "quote_14": "Ne budite ljudi bez vlastitog uma, govoreći da ćete postupati dobro prema drugima samo ako oni dobro postupaju prema vama. Umjesto toga, naviknite se činiti dobro ako ljudi čine dobro i ne činiti zlo ako oni čine zlo.",
    "author_14": "Poslanik Muhammed (a.s.)",
    "quote_15": "Zaista, s teškoćom dolazi olakšanje.",
    "author_15": "Kur'an 94:6",
    "quote_16": "Budi kao dijamant, dragocjen i rijedak, a ne kao kamen koji se svugdje nalazi.",
    "author_16": "Imam Ali ibn Ebi Talib",
    "quote_17": "Najbolji među ljudima su oni koji donose najviše koristi ostalim ljudima.",
    "author_17": "Poslanik Muhammed (a.s.)",
    "quote_18": "Jučer sam bio pametan pa sam htio promijeniti svijet. Danas sam mudar pa mijenjam sebe.",
    "author_18": "Rumi",
    "quote_19": "Obrazovanje je najmoćnije oružje koje možete koristiti da promijenite svijet.",
    "author_19": "Muhammed Ikbal",
    "quote_20": "Moja ljudskost je vezana za tvoju, jer možemo biti ljudi samo zajedno.",
    "author_20": "Alija Izetbegović",
    "quote_21": "Tinta učenjaka je svetija od krvi šehida.",
    "author_21": "Poslanik Muhammed (a.s.)",
    "quote_22": "Da bi dobio ono što voliš, moraš prvo biti strpljiv s onim što mrziš.",
    "author_22": "Imam El-Gazali",
    "quote_23": "Ne gubite nadu i ne tugujte.",
    "author_23": "Kur'an 3:139",
    "quote_24": "Ako želiš više fokusa na Allaha u svojim namazima, fokusiraj se više na Njega van namaza.",
    "author_24": "Yasmin Mogahed",
    "quote_25": "Obračunajte se sami prije nego budete obračunati.",
    "author_25": "Omer ibn el-Hattab",
    "quote_26": "Neka vas mržnja nekog naroda ne odvrati od pravde. Budite pravedni, jer je to najbliže bogobojaznosti.",
    "author_26": "Kur'an 5:8",
    "quote_27": "Što više pustiš, više se uzdižeš.",
    "author_27": "Rumi",
    "quote_28": "Prava moć je suzdržavanje kada imaš mogućnost udariti.",
    "author_28": "Imam Ali ibn Ebi Talib",
    "quote_29": "Nosimo u sebi čuda koja tražimo izvan sebe.",
    "author_29": "Rumi"
  },
