{
  "name": "shopify-rental-app",
  "version": "1.0.0",
  "description": "General-purpose Shopify rental app — rent out any product in your store",
  "main": "server/index.js",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "start": "node server/index.js",
    "render-start": "npx prisma migrate deploy && node server/index.js",
    "build": "cd web && npm run build",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "setup": "npm install && cd web && npm install && cd .. && npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@shopify/shopify-api": "^9.7.0",
    "@shopify/shopify-app-express": "^4.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^4.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
