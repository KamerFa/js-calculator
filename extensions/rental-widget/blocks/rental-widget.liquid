{% comment %}
  Rental Widget — Theme App Extension block
  Renders on product pages for rentable products.
  Two style modes: inherit theme (default) or standalone.
{% endcomment %}

<div
  id="rental-widget-{{ product.id }}"
  class="rental-widget"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-proxy-url="{{ shop.url }}/apps/rentals"
  data-inherit-theme="{{ block.settings.inherit_theme }}"
  data-primary-color="{{ block.settings.primary_color }}"
  data-border-radius="{{ block.settings.border_radius }}"
>
  <div class="rental-widget__loading">
    <span class="rental-widget__spinner"></span>
    Loading rental options…
  </div>
</div>

{{ 'rental-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rental-widget.js' | asset_url }}" defer></script>

<script>
  // Fallback: if the external JS doesn't initialize the widget within 8s, show a helpful error
  (function() {
    var widgetEl = document.getElementById('rental-widget-{{ product.id }}');
    if (!widgetEl) return;
    setTimeout(function() {
      if (widgetEl.querySelector('.rental-widget__loading')) {
        widgetEl.innerHTML = '<div class="rental-widget__error" style="padding:1em;color:#721c24;background:#f8d7da;border:1px solid #f5c6cb;border-radius:4px;">' +
          'Rental widget failed to load. Please ensure the theme extension is deployed and the app proxy is configured.' +
          '</div>';
      }
    }, 8000);
  })();
</script>

{% schema %}
{
  "name": "Rent This Item",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_theme",
      "label": "Inherit theme styles",
      "default": true,
      "info": "When enabled, the widget picks up your theme's typography, colors, and spacing."
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary color (standalone mode)",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "border_radius",
      "label": "Border radius (standalone mode)",
      "default": "4px"
    }
  ]
}
{% endschema %}
